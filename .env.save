# ═══════════════════════════════════════════════════════════════════
# إن مصر للصناعة — Production Environment
# Domain: inmisr.net | Company: داتا لايف لخدمات الذكاء الصناعي
# ═══════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
CORS_ORIGINS=https://inmisr.net,https://www.inmisr.net,https://app.inmisr.net

# ── URLs ───────────────────────────────────────────────────────────
APP_URL=https://inmisr.net
API_URL=https://api.inmisr.net
FRONTEND_URL=https://inmisr.net
RESET_PASSWORD_URL=https://inmisr.net/reset-password

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://inmisr:CHANGE_STRONG_PASSWORD@localhost:5432/inmisr_db
DB_PASSWORD=CHANGE_STRONG_PASSWORD_HERE

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_REDIS_PASSWORD@localhost:6379
REDIS_PASSWORD=CHANGE_REDIS_PASSWORD_HERE

# ── RabbitMQ ───────────────────────────────────────────────────────
RABBITMQ_URL=amqp://inmisr:CHANGE_RABBIT_PASSWORD@localhost:5672
RABBITMQ_PASSWORD=CHANGE_RABBIT_PASSWORD_HERE

# ── JWT — Generate with: openssl rand -hex 64 ──────────────────────
JWT_ACCESS_SECRET=REPLACE_WITH_openssl_rand_hex_64_output_here
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_openssl_rand_hex_64_output

# ── Encryption — Generate with: openssl rand -base64 32 ────────────
ENCRYPTION_MASTER_KEY=REPLACE_WITH_openssl_rand_base64_32_output_here

# ── Paymob ─────────────────────────────────────────────────────────
# من: dashboard.paymob.com → Settings → Account Info
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret
# Callback URLs اللي هتحطيها في Paymob Dashboard:
# Transaction Callback: https://api.inmisr.net/webhooks/paymob/transaction
# Response URL: https://inmisr.net/payment/callback

# ── Fawry ──────────────────────────────────────────────────────────
FAWRY_MERCHANT_CODE=your_fawry_merchant_code
FAWRY_SECURITY_KEY=your_fawry_security_key
FAWRY_BASE_URL=https://www.atfawry.com

# ── Twilio SMS (OTP) ───────────────────────────────────────────────
# من: console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+20xxxxxxxxx

# ── Email (SMTP — SiteGround) ────────────────────────────────────
SMTP_HOST=mail.inmisr.net
SMTP_PORT=465
SMTP_USER=noreply@inmisr.net
SMTP_PASS=NR@2026msr#
SMTP_FROM_EMAIL=noreply@inmisr.net
SMTP_FROM_NAME=إن مصر للصناعة

# ── Firebase (Push Notifications) ─────────────────────────────────
# من: console.firebase.google.com → Project Settings → Cloud Messaging
FCM_SERVER_KEY=your_firebase_server_key
FCM_PROJECT_ID=inmisr-industry

# ── AWS ────────────────────────────────────────────────────────────
# من: console.aws.amazon.com → IAM → Users → Create Access Key
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=inmisr-industry-files
AWS_REGION=me-south-1
AWS_CLOUDFRONT_URL=https://dxxxxxxxxxx.cloudfront.net

# ── Google Maps ────────────────────────────────────────────────────
# من: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_MAPS_KEY=your_google_maps_api_key

# ── Elasticsearch ──────────────────────────────────────────────────
ELASTIC_URL=http://localhost:9200
ELASTIC_PASSWORD=your_elastic_password

# ── ETA (مصلحة الضرائب — الفاتورة الإلكترونية) ─────────────────────
# عندك بالفعل من تسجيل الفاتورة الإلكترونية
ETA_BASE_URL=https://api.invoicing.eta.gov.eg/api/v1
ETA_CLIENT_ID=your_eta_client_id_من_البوابة
ETA_CLIENT_SECRET=your_eta_client_secret_من_البوابة
ETA_SUPPLIER_TIN=your_tax_identification_number
ETA_SIGNING_KEY=your_signing_key

# ── CIB Escrow ─────────────────────────────────────────────────────
# بعد الاتفاق مع CIB Corporate Banking (19666)
CIB_ESCROW_ACCOUNT=your_cib_escrow_account_number
CIB_API_KEY=your_cib_api_key_if_available

# ── Admin ──────────────────────────────────────────────────────────
ADMIN_INITIAL_PASSWORD=ADmsr@2026#
ADMIN_EMAIL=admin@inmisr.net

# ── pgAdmin ────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@inmisr.net
PGADMIN_PASSWORD=your_pgadmin_password
