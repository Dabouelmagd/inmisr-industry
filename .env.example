# ═══════════════════════════════════════════════════════════════════
# إن مصر للصناعة — Complete Environment Variables
# انسخ إلى .env وعبّئ القيم الحقيقية — لا تُضف هذا الملف إلى git
# ═══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://inmisr:CHANGE_PASSWORD@localhost:5432/inmisr_db
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_PASSWORD@localhost:6379
REDIS_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── RabbitMQ ──────────────────────────────────────────────────────
RABBITMQ_URL=amqp://inmisr:CHANGE_PASSWORD@localhost:5672
RABBITMQ_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── Security — use: openssl rand -hex 64 ──────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_different_from_access_secret_64chars
ENCRYPTION_MASTER_KEY=CHANGE_ME_minimum_32_characters_strong_key!!

# ── Paymob (البنك المركزي مرخص) ───────────────────────────────────
PAYMOB_API_KEY=your_paymob_api_key_from_dashboard
PAYMOB_INTEGRATION_ID=your_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret_from_paymob

# ── Fawry ─────────────────────────────────────────────────────────
FAWRY_MERCHANT_CODE=your_fawry_merchant_code
FAWRY_SECURITY_KEY=your_fawry_security_key
FAWRY_BASE_URL=https://atfawry.fawrystaging.com

# ── Twilio (SMS / OTP) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+20xxxxxxxxx

# ── SMTP (Email — SiteGround) ─────────────────────────────────────
SMTP_HOST=mail.inmisr.net
SMTP_PORT=465
SMTP_USER=noreply@inmisr.net
SMTP_PASS=your_siteground_email_account_password
SMTP_FROM_EMAIL=noreply@inmisr.net
SMTP_FROM_NAME=إن مصر للصناعة

# ── Firebase FCM (Push) ───────────────────────────────────────────
FCM_SERVER_KEY=your_firebase_server_key
FCM_PROJECT_ID=inmisr-industry

# ── AWS ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=inmisr-industry-files
AWS_REGION=me-south-1
AWS_CLOUDFRONT_URL=https://dxxxxxxxxxx.cloudfront.net
AWS_TEXTRACT_REGION=me-south-1

# ── Google Maps ───────────────────────────────────────────────────
GOOGLE_MAPS_KEY=your_google_maps_api_key

# ── Elasticsearch ─────────────────────────────────────────────────
ELASTIC_URL=http://localhost:9200
ELASTIC_PASSWORD=your_elastic_password

# ── Egyptian Tax Authority (ETA) ──────────────────────────────────
ETA_BASE_URL=https://api.invoicing.eta.gov.eg/api/v1
ETA_CLIENT_ID=your_eta_client_id
ETA_CLIENT_SECRET=your_eta_client_secret
ETA_SUPPLIER_TIN=your_tax_identification_number
ETA_SIGNING_KEY=your_signing_key

# ── External Validation APIs ──────────────────────────────────────
GAFI_API_URL=https://api.investment.gov.eg
ETA_VALIDATE_URL=https://api.eta.gov.eg/taxpayer

# ── Admin Setup ───────────────────────────────────────────────────
ADMIN_INITIAL_PASSWORD=Admin@InMisr2025!_ChangeMe
PGADMIN_EMAIL=admin@inmisr.net
PGADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
