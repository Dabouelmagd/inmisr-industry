  sectorId       String
  region         String
  investmentReq  Float
  roiEstimate    Float
  paybackMonths  Int
  demandDataJson Json
  factoriesJson  Json     @default("[]")
  fundingJson    Json     @default("[]")
  status         String   @default("PUBLISHED")
  viewCount      Int      @default(0)
  interestCount  Int      @default(0)
