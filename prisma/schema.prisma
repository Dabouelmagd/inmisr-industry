// ─── NOTIFICATIONS ────────────────────────────────────────────────
model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  titleAr   String
  bodyAr    String
  titleEn   String?
  bodyEn    String?
  data      Json?
  channels  NotificationChannel[]
  isRead    Boolean             @default(false)
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── ADS ──────────────────────────────────────────────────────────
model AdCampaign {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  name           String
  type           AdType
  bidModel       BidModel
  bidAmount      Float
  dailyBudget    Float
  totalBudget    Float
  startDate      DateTime
  endDate        DateTime
  status         AdStatus  @default(PENDING)
  targetSectors  Json      @default("[]")
  targetCities   Json      @default("[]")
  creativeJson   Json
  impressions    Int       @default(0)
  clicks         Int       @default(0)
  conversions    Int       @default(0)
  spent          Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, status])
  @@index([status, startDate, endDate])
  @@index([type, status])
  @@map("ad_campaigns")
}

// ─── AUDIT & SECURITY ─────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, action, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model LeakageAttempt {
  id          String   @id @default(uuid())
  userId      String
  messageId   String?
  orderId     String?
  patternType String
  rawContent  String
  sanitized   String
  action      String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("leakage_attempts")
}

model AnomalyAlert {
  id          String   @id @default(uuid())
  userId      String
  type        String
  score       Float
  description String
  metadata    Json?
  isResolved  Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, isResolved])
  @@index([score])
  @@map("anomaly_alerts")
}

// ─── PRICE FORECAST CACHE ─────────────────────────────────────────
model PriceForecastCache {
  id           String   @id @default(uuid())
  sectorCode   String   @unique
  forecastJson Json
  generatedAt  DateTime @default(now())
  expiresAt    DateTime

  @@index([sectorCode])
  @@index([expiresAt])
  @@map("price_forecast_cache")
}
